diff --git a/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/controllers/BooksControllerTest.java b/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/controllers/BooksControllerTest.java
new file mode 100644
index 0000000..6b807e1
--- /dev/null
+++ b/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/controllers/BooksControllerTest.java
@@ -0,0 +1,81 @@
+package com.example.TheFinalBookStore.controllers;
+
+import com.example.TheFinalBookStore.models.Book;
+import com.example.TheFinalBookStore.services.BookService;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import java.util.List;
+import java.util.Optional;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+@WebMvcTest(BooksController.class)
+class BooksControllerTest {
+
+    @Autowired
+    private MockMvc mvc;
+
+    @MockBean
+    private BookService bookService;
+
+    private static Book sampleBook() {
+        return new Book(1, "Author", "Title", "Svenska", "2020", "Förlag", "100", "Roman", "3", "");
+    }
+
+    @Test
+    void bookshopPassesSearchAndSortToService() throws Exception {
+        when(bookService.findAll("hobbit", "author")).thenReturn(List.of(sampleBook()));
+
+        mvc.perform(get("/bookshop").param("q", "hobbit").param("sort", "author"))
+                .andExpect(status().isOk())
+                .andExpect(view().name("booksviewmysql"));
+    }
+
+    @Test
+    void bookshopUsesTitleSortByDefault() throws Exception {
+        when(bookService.findAll(any(), anyString())).thenReturn(List.of());
+
+        mvc.perform(get("/bookshop")).andExpect(status().isOk());
+        verify(bookService).findAll(null, "title");
+    }
+
+    @Test
+    void unknownBookReturnsNotFound() throws Exception {
+        when(bookService.findByISBN(42)).thenReturn(Optional.empty());
+
+        mvc.perform(get("/book/42")).andExpect(status().isNotFound());
+    }
+
+    @Test
+    void deleteIsOnlyAllowedWithPost() throws Exception {
+        mvc.perform(get("/book/1/drop")).andExpect(status().isMethodNotAllowed());
+        verify(bookService, never()).deleteBook(any());
+    }
+
+    @Test
+    void postDeleteRemovesBook() throws Exception {
+        when(bookService.deleteBook(1)).thenReturn(true);
+
+        mvc.perform(post("/book/1/drop"))
+                .andExpect(status().isOk())
+                .andExpect(view().name("changesSaved"));
+    }
+
+    @Test
+    void failedUpdateShowsEditFormWithError() throws Exception {
+        when(bookService.updateBook(any())).thenThrow(new IllegalArgumentException("Ingen bok"));
+
+        mvc.perform(post("/book/1/edit").param("title", "Ny titel"))
+                .andExpect(status().isOk())
+                .andExpect(view().name("editview"))
+                .andExpect(model().attribute("errorMessage", "Ingen bok"));
+    }
+}
diff --git a/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/services/BookServiceTest.java b/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/services/BookServiceTest.java
new file mode 100644
index 0000000..c5061e8
--- /dev/null
+++ b/TheFinalBookStore/src/test/java/com/example/TheFinalBookStore/services/BookServiceTest.java
@@ -0,0 +1,53 @@
+package com.example.TheFinalBookStore.services;
+
+import com.example.TheFinalBookStore.models.Book;
+import com.example.TheFinalBookStore.repositorys.IBookCrud;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.util.List;
+import java.util.Optional;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@ExtendWith(MockitoExtension.class)
+class BookServiceTest {
+
+    @Mock
+    private IBookCrud crud;
+
+    @InjectMocks
+    private BookService service;
+
+    @Test
+    void findByISBNReturnsEmptyWhenMissing() {
+        when(crud.findByISBN(1)).thenReturn(Optional.empty());
+        assertTrue(service.findByISBN(1).isEmpty());
+    }
+
+    @Test
+    void findByISBNReturnsBookWhenPresent() {
+        Book book = new Book(1, "Author", "Title", null, null, null, null, null, null, null);
+        when(crud.findByISBN(1)).thenReturn(Optional.of(book));
+        assertEquals("Title", service.findByISBN(1).orElseThrow().getTitle());
+    }
+
+    @Test
+    void findAllPassesSearchAndSortToRepository() {
+        when(crud.findAll("tolkien", "author")).thenReturn(List.of());
+        assertEquals(List.of(), service.findAll("tolkien", "author"));
+        verify(crud).findAll("tolkien", "author");
+    }
+
+    @Test
+    void deleteBookReportsWhetherRowWasRemoved() {
+        when(crud.deleteBook(5)).thenReturn(true);
+        when(crud.deleteBook(6)).thenReturn(false);
+        assertTrue(service.deleteBook(5));
+        assertFalse(service.deleteBook(6));
+    }
+}
